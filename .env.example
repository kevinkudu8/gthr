# Contact form delivery (Resend — https://resend.com). Without RESEND_API_KEY the
# form tells the visitor to email instead of pretending to send.
RESEND_API_KEY=
# Where inquiries go. Defaults to the site email in src/content/site.ts.
CONTACT_TO=
# Verified sender. Defaults to Resend's onboarding sender, which only delivers
# to your own Resend account email.
CONTACT_FROM=
